# Kopiera denna fil till .env och fyll i värden från Supabase Dashboard
# (Project Settings -> API). anon key är publik/ofarlig att dela --
# skyddet sker via Row Level Security i databasen, inte genom att nyckeln
# är hemlig. service_role key ska ALDRIG hamna här eller i klientkod.

EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxx
