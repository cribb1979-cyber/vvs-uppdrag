# Kopiera denna fil till .env och fyll i värden från Supabase Dashboard
# (Project Settings -> API). Använd "Publishable key" (sb_publishable_...),
# INTE den äldre eyJ...-JWT-nyckeln -- Supabase fasar ut JWT-formatet och
# nya projekt kan ha det inaktiverat som standard (ger "Invalid API key").
# Publishable key är publik/ofarlig att dela -- skyddet sker via Row Level
# Security i databasen, inte genom att nyckeln är hemlig. Secret key
# (sb_secret_...) ska ALDRIG hamna här eller i klientkod.

EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx
