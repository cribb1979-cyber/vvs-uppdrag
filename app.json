{
  "expo": {
    "name": "VVS Uppdrag",
    "slug": "vvs-uppdrag",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vvsuppdrag",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "se.yrkesapl.vvsuppdrag",
      "infoPlist": {
        "NSCameraUsageDescription": "Kameran används för att skanna QR-koder till uppdrag och hyllor.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "se.yrkesapl.vvsuppdrag",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.CAMERA", "android.permission.RECORD_AUDIO"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Kameran används för att skanna QR-koder till uppdrag och hyllor."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Väljer bilder till quizfrågor och materialregistret.",
          "cameraPermission": "Fotograferar rördelar till quizfrågor och materialregistret."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "241388cb-028e-4720-9b3b-6e75dcc3494c"
      }
    }
  }
}
